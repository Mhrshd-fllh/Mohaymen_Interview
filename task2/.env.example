# MinIO S3 API Endpoint & Secure Credentials
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_secure_access_key_here
MINIO_SECRET_KEY=your_super_secret_password_here_at_least_8_chars

# MinIO Buckets
MINIO_INPUT_BUCKET=telemetry-bucket
MINIO_OUTPUT_BUCKET=reports-bucket

# Spark Hadoop-AWS Package Versions
SPARK_HADOOP_AWS_PACKAGE=org.apache.hadoop:hadoop-aws:3.3.4
AWS_JAVA_SDK_PACKAGE=com.amazonaws:aws-java-sdk-bundle:1.12.262
